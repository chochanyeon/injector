{
  "id": "orders",
  "kind": "application",
  "variants": {
    "local": {
      "execution": {
        "type": "process",
        "workingDirectory": ".",
        "command": [
          "java",
          "-cp",
          "services/orders/build/install/orders/lib/*",
          "shop.orders.Main"
        ]
      },
      "dependencies": [
        "catalog",
        "inventory",
        "postgres",
        "kafka"
      ],
      "endpoints": {
        "http": {
          "protocol": "http",
          "bind": {
            "host": "127.0.0.1",
            "port": 19781
          },
          "addresses": {
            "host": {
              "host": "127.0.0.1",
              "port": 19781,
              "scheme": "http"
            }
          }
        }
      },
      "readiness": {
        "type": "http",
        "endpoint": "http",
        "path": "/health",
        "timeoutSeconds": 25
      },
      "env": {
        "APP_PORT": "19781",
        "DB_NAME": "shop",
        "DB_USER": "shop",
        "DB_PASSWORD": "demo-only"
      },
      "injections": [
        {
          "channel": "environment",
          "key": "CATALOG_URL",
          "source": {
            "node": "catalog",
            "endpoint": "http",
            "context": "host",
            "component": "url"
          }
        },
        {
          "channel": "environment",
          "key": "INVENTORY_URL",
          "source": {
            "node": "inventory",
            "endpoint": "http",
            "context": "host",
            "component": "url"
          }
        },
        {
          "channel": "environment",
          "key": "DB_HOST",
          "source": {
            "node": "postgres",
            "endpoint": "tcp",
            "context": "host",
            "component": "host"
          }
        },
        {
          "channel": "environment",
          "key": "DB_PORT",
          "source": {
            "node": "postgres",
            "endpoint": "tcp",
            "context": "host",
            "component": "port"
          }
        },
        {
          "channel": "environment",
          "key": "KAFKA_HOST",
          "source": {
            "node": "kafka",
            "endpoint": "tcp",
            "context": "host",
            "component": "host"
          }
        },
        {
          "channel": "environment",
          "key": "KAFKA_PORT",
          "source": {
            "node": "kafka",
            "endpoint": "tcp",
            "context": "host",
            "component": "port"
          }
        }
      ]
    }
  }
}
