{
  "id": "notifications",
  "kind": "application",
  "variants": {
    "local": {
      "execution": {
        "type": "process",
        "workingDirectory": ".",
        "command": [
          "java",
          "-cp",
          "services/notifications/build/install/notifications/lib/*",
          "shop.notifications.Main"
        ]
      },
      "dependencies": [
        "kafka",
        "redis"
      ],
      "endpoints": {
        "http": {
          "protocol": "http",
          "bind": {
            "host": "127.0.0.1",
            "port": 19785
          },
          "addresses": {
            "host": {
              "host": "127.0.0.1",
              "port": 19785,
              "scheme": "http"
            }
          }
        }
      },
      "readiness": {
        "type": "http",
        "endpoint": "http",
        "path": "/health",
        "timeoutSeconds": 25
      },
      "env": {
        "APP_PORT": "19785"
      },
      "injections": [
        {
          "channel": "environment",
          "key": "KAFKA_HOST",
          "source": {
            "node": "kafka",
            "endpoint": "tcp",
            "context": "host",
            "component": "host"
          }
        },
        {
          "channel": "environment",
          "key": "KAFKA_PORT",
          "source": {
            "node": "kafka",
            "endpoint": "tcp",
            "context": "host",
            "component": "port"
          }
        },
        {
          "channel": "environment",
          "key": "REDIS_HOST",
          "source": {
            "node": "redis",
            "endpoint": "tcp",
            "context": "host",
            "component": "host"
          }
        },
        {
          "channel": "environment",
          "key": "REDIS_PORT",
          "source": {
            "node": "redis",
            "endpoint": "tcp",
            "context": "host",
            "component": "port"
          }
        }
      ]
    }
  }
}
