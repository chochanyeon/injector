{
  "id": "storefront",
  "kind": "application",
  "variants": {
    "local": {
      "execution": {
        "type": "process",
        "workingDirectory": ".",
        "command": [
          "java",
          "-cp",
          "services/storefront/build/install/storefront/lib/*",
          "shop.storefront.Main"
        ]
      },
      "dependencies": [
        "orders",
        "catalog",
        "notifications",
        "redis",
        "loki"
      ],
      "endpoints": {
        "http": {
          "protocol": "http",
          "bind": {
            "host": "127.0.0.1",
            "port": 19780
          },
          "addresses": {
            "host": {
              "host": "127.0.0.1",
              "port": 19780,
              "scheme": "http"
            }
          }
        }
      },
      "readiness": {
        "type": "http",
        "endpoint": "http",
        "path": "/health",
        "timeoutSeconds": 25
      },
      "env": {
        "APP_PORT": "19780",
        "SHOP_SERVICE": "storefront"
      },
      "injections": [
        {
          "channel": "environment",
          "key": "ORDERS_URL",
          "source": {
            "node": "orders",
            "endpoint": "http",
            "context": "host",
            "component": "url"
          }
        },
        {
          "channel": "environment",
          "key": "CATALOG_URL",
          "source": {
            "node": "catalog",
            "endpoint": "http",
            "context": "host",
            "component": "url"
          }
        },
        {
          "channel": "environment",
          "key": "NOTIFICATIONS_URL",
          "source": {
            "node": "notifications",
            "endpoint": "http",
            "context": "host",
            "component": "url"
          }
        },
        {
          "channel": "environment",
          "key": "REDIS_HOST",
          "source": {
            "node": "redis",
            "endpoint": "tcp",
            "context": "host",
            "component": "host"
          }
        },
        {
          "channel": "environment",
          "key": "REDIS_PORT",
          "source": {
            "node": "redis",
            "endpoint": "tcp",
            "context": "host",
            "component": "port"
          }
        },
        {
          "channel": "environment",
          "key": "LOKI_URL",
          "source": {
            "node": "loki",
            "endpoint": "http",
            "context": "host",
            "component": "url"
          }
        }
      ]
    }
  }
}
