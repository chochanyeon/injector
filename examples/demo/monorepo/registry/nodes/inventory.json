{
  "id": "inventory",
  "kind": "application",
  "variants": {
    "local": {
      "execution": {
        "type": "process",
        "workingDirectory": ".",
        "command": [
          "java",
          "-cp",
          "services/inventory/build/install/inventory/lib/*",
          "shop.inventory.Main"
        ]
      },
      "dependencies": [
        "postgres"
      ],
      "endpoints": {
        "http": {
          "protocol": "http",
          "bind": {
            "host": "127.0.0.1",
            "port": 19784
          },
          "addresses": {
            "host": {
              "host": "127.0.0.1",
              "port": 19784,
              "scheme": "http"
            }
          }
        }
      },
      "readiness": {
        "type": "http",
        "endpoint": "http",
        "path": "/health",
        "timeoutSeconds": 25
      },
      "env": {
        "APP_PORT": "19784",
        "DB_NAME": "shop",
        "DB_USER": "shop",
        "DB_PASSWORD": "demo-only"
      },
      "injections": [
        {
          "channel": "environment",
          "key": "DB_HOST",
          "source": {
            "node": "postgres",
            "endpoint": "tcp",
            "context": "host",
            "component": "host"
          }
        },
        {
          "channel": "environment",
          "key": "DB_PORT",
          "source": {
            "node": "postgres",
            "endpoint": "tcp",
            "context": "host",
            "component": "port"
          }
        }
      ]
    }
  }
}
