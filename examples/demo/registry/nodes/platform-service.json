{
  "id": "platform-service",
  "kind": "application",
  "variants": {
    "ide": {
      "execution": {
        "type": "intellij",
        "projectPath": ".",
        "module": "injector-poc",
        "mainClass": "poc.Main"
      },
      "endpoints": {
        "http": {
          "protocol": "http",
          "bind": {
            "host": "127.0.0.1",
            "port": 19080
          },
          "addresses": {
            "host": {
              "host": "127.0.0.1",
              "port": 19080,
              "scheme": "http"
            }
          }
        }
      },
      "dependencies": [
        "catalog",
        "redis",
        "vault-mock"
      ],
      "readiness": {
        "type": "http",
        "endpoint": "http",
        "path": "/demo",
        "timeoutSeconds": 30
      },
      "env": {
        "APP_PORT": "19080",
        "DEMO_MESSAGE": "prepared from the local UI"
      },
      "vmOptions": [
        "-Xmx256m"
      ],
      "vmProperties": {
        "file.encoding": "UTF-8"
      },
      "injections": [
        {
          "channel": "environment",
          "key": "CATALOG_URL",
          "source": {
            "node": "catalog",
            "endpoint": "main",
            "context": "host",
            "component": "url"
          }
        },
        {
          "channel": "environment",
          "key": "REDIS_HOST",
          "source": {
            "node": "redis",
            "endpoint": "main",
            "context": "host",
            "component": "host"
          }
        },
        {
          "channel": "environment",
          "key": "REDIS_PORT",
          "source": {
            "node": "redis",
            "endpoint": "main",
            "context": "host",
            "component": "port"
          }
        },
        {
          "channel": "environment",
          "key": "VAULT_ADDR",
          "source": {
            "node": "vault-mock",
            "endpoint": "main",
            "context": "host",
            "component": "url"
          }
        }
      ]
    }
  },
  "profileOverrides": {
    "dummy": {
      "vmProperties": {
        "injector.profile": "dummy"
      }
    },
    "real": {
      "vmProperties": {
        "injector.profile": "real"
      }
    }
  }
}
