{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Injector runtime registry v1.0",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "defaults": {
      "$ref": "#/$defs/settings"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 1
    },
    "nodeFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      },
      "minProperties": 1
    },
    "nameMappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hostname": {
            "type": "string",
            "minLength": 1
          },
          "address": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "enum": [
              "hosts",
              "external"
            ]
          }
        },
        "required": [
          "hostname",
          "address",
          "method"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "profiles"
  ],
  "anyOf": [
    {"required": ["nodes"]},
    {"required": ["nodeFiles"]}
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "value": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "fromEnv": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "required": [
            "fromEnv"
          ],
          "additionalProperties": false
        }
      ]
    },
    "settings": {
      "type": "object",
      "properties": {
        "env": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "vmOptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "^-D"
            }
          }
        },
        "vmProperties": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "execution": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "process"
            },
            "command": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "workingDirectory": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "command",
            "workingDirectory"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "intellij"
            },
            "projectPath": {
              "type": "string",
              "minLength": 1
            },
            "module": {
              "type": "string",
              "minLength": 1
            },
            "mainClass": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "projectPath",
            "module",
            "mainClass"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "compose"
            },
            "file": {
              "type": "string",
              "minLength": 1
            },
            "service": {
              "type": "string",
              "minLength": 1
            },
            "projectName": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "type",
            "file",
            "service",
            "projectName"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "external"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "endpoint": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "bind": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "$ref": "#/$defs/port"
            }
          },
          "required": [
            "host",
            "port"
          ],
          "additionalProperties": false
        },
        "addresses": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "host": {
              "type": "object",
              "properties": {
                "host": {
                  "type": "string",
                  "minLength": 1
                },
                "port": {
                  "$ref": "#/$defs/port"
                },
                "scheme": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "pattern": "^/"
                }
              },
              "required": [
                "host",
                "port"
              ],
              "additionalProperties": false
            },
            "container": {
              "type": "object",
              "properties": {
                "host": {
                  "type": "string",
                  "minLength": 1
                },
                "port": {
                  "$ref": "#/$defs/port"
                },
                "scheme": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "pattern": "^/"
                }
              },
              "required": [
                "host",
                "port"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "protocol",
        "bind",
        "addresses"
      ],
      "additionalProperties": false
    },
    "injection": {
      "type": "object",
      "properties": {
        "channel": {
          "enum": [
            "environment",
            "vmProperty"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "properties": {
            "node": {
              "$ref": "#/$defs/id"
            },
            "endpoint": {
              "$ref": "#/$defs/id"
            },
            "context": {
              "enum": [
                "host",
                "container"
              ]
            },
            "component": {
              "enum": [
                "url",
                "host",
                "port"
              ]
            }
          },
          "required": [
            "node",
            "endpoint",
            "context",
            "component"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "channel",
        "key",
        "source"
      ],
      "additionalProperties": false
    },
    "readiness": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "http"
            },
            "endpoint": {
              "$ref": "#/$defs/id"
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "timeoutSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "type",
            "endpoint",
            "path",
            "timeoutSeconds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "tcp"
            },
            "endpoint": {
              "$ref": "#/$defs/id"
            },
            "timeoutSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "type",
            "endpoint",
            "timeoutSeconds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "compose"
            },
            "timeoutSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "type",
            "timeoutSeconds"
          ],
          "additionalProperties": false
        }
      ]
    },
    "variant": {
      "type": "object",
      "properties": {
        "execution": {
          "$ref": "#/$defs/execution"
        },
        "endpoints": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "readiness": {
          "$ref": "#/$defs/readiness"
        },
        "injections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/injection"
          }
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "vmOptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "^-D"
            }
          }
        },
        "vmProperties": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      },
      "required": [
        "execution",
        "endpoints",
        "dependencies",
        "readiness"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "application",
            "infrastructure"
          ]
        },
        "variants": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/variant"
          },
          "minProperties": 1
        },
        "profileOverrides": {
          "$ref": "#/$defs/profile/properties/overrides"
        }
      },
      "required": [
        "id",
        "kind",
        "variants"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "selections": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/id"
          }
        },
        "overrides": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/settings"
          }
        }
      },
      "required": [
        "targets",
        "selections"
      ],
      "additionalProperties": false
    }
  }
}
