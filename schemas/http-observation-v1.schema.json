{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local dependency observation",
  "oneOf": [{"$ref": "#/$defs/scenario"}, {"$ref": "#/$defs/observation"},
            {"$ref": "#/$defs/traceScenario"}, {"$ref": "#/$defs/traceObservation"}, {"$ref": "#/$defs/suite"}],
  "$defs": {
    "name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.-]+$"},
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "name", "target", "profile", "cases"],
      "properties": {
        "schemaVersion": {"const": 1},
        "name": {"$ref": "#/$defs/name"},
        "target": {"$ref": "#/$defs/name"},
        "profile": {"$ref": "#/$defs/name"},
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scenario"],
            "properties": {
              "scenario": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[^\\u0000-\\u001F]+$"},
              "proveFix": {"$ref": "#/$defs/name"}
            }
          }
        }
      }
    },
    "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
    "path": {"type": "string", "maxLength": 2048, "pattern": "^/(?!/)[^#\\r\\n]*$"},
    "route": {"type": "string", "maxLength": 2048, "pattern": "^/(?!/)[^?#\\r\\n]*$"},
    "pointer": {"type": "string", "maxLength": 256, "pattern": "^(/([^~/]|~[01])*)+$"},
    "pointers": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/pointer"}},
    "queryKey": {"type": "string", "minLength": 1, "maxLength": 256},
    "fields": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {"$ref": "#/$defs/pointer"},
      "additionalProperties": {"type": ["string", "number", "boolean", "null"], "maxLength": 2048}
    },
    "status": {"type": "integer", "minimum": 200, "maximum": 599},
    "expectedResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "fields": {"$ref": "#/$defs/fields"}
      }
    },
    "stateCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when", "node", "endpoint", "path", "expect"],
      "properties": {
        "id": {"$ref": "#/$defs/name"},
        "when": {"enum": ["before", "after"]},
        "node": {"$ref": "#/$defs/name"},
        "endpoint": {"$ref": "#/$defs/name"},
        "path": {"$ref": "#/$defs/path"},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 60},
        "expect": {"$ref": "#/$defs/expectedResponse"}
      }
    },
    "checkEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when", "verdict", "expected"],
      "properties": {
        "id": {"$ref": "#/$defs/name"},
        "when": {"enum": ["before", "response", "after", "trace"]},
        "verdict": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
        "expected": true,
        "actual": true,
        "reason": {"enum": ["response-unavailable", "invalid-response-fields", "unexpected-initial-state", "trace-incomplete"]}
      },
      "if": {"properties": {"when": {"const": "trace"}}},
      "then": {"properties": {"expected": {"$ref": "#/$defs/countValue"}, "actual": {"$ref": "#/$defs/countValue"}}},
      "else": {"properties": {"expected": {"$ref": "#/$defs/expectedResponse"}, "actual": {"$ref": "#/$defs/expectedResponse"}}}
    },
    "eventCount": {"type": "integer", "minimum": 0, "maximum": 128},
    "countValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count"],
      "properties": {"count": {"$ref": "#/$defs/eventCount"}}
    },
    "traceKind": {"enum": ["http_request", "http_dependency", "kafka_publish", "kafka_consume"]},
    "traceSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "event"],
      "properties": {
        "service": {"$ref": "#/$defs/name"},
        "event": {"$ref": "#/$defs/traceKind"},
        "dependency": {"$ref": "#/$defs/name"}
      },
      "if": {"properties": {"event": {"const": "http_dependency"}}},
      "then": {"required": ["dependency"]},
      "else": {"not": {"required": ["dependency"]}}
    },
    "traceEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "event"],
      "properties": {
        "service": {"$ref": "#/$defs/name"},
        "event": {"$ref": "#/$defs/traceKind"},
        "dependency": {"$ref": "#/$defs/name"},
        "method": {"$ref": "#/$defs/method"},
        "path": {"$ref": "#/$defs/route"},
        "status": {"$ref": "#/$defs/status"},
        "topic": {"$ref": "#/$defs/name"}
      },
      "allOf": [{
        "if": {"properties": {"event": {"enum": ["http_request", "http_dependency"]}}},
        "then": {"required": ["method", "path", "status"], "not": {"required": ["topic"]}},
        "else": {"required": ["topic"], "not": {"anyOf": [{"required": ["method"]}, {"required": ["path"]}, {"required": ["status"]}]}}
      }, {
        "if": {"properties": {"event": {"const": "http_dependency"}}},
        "then": {"required": ["dependency"]},
        "else": {"not": {"required": ["dependency"]}}
      }]
    },
    "traceScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "name", "targetEndpoint", "request", "trace"],
      "properties": {
        "schemaVersion": {"const": 2},
        "name": {"$ref": "#/$defs/name"},
        "targetEndpoint": {"$ref": "#/$defs/name"},
        "request": {"$ref": "#/$defs/scenario/properties/request"},
        "targetFields": {"$ref": "#/$defs/pointers"},
        "expect": {"$ref": "#/$defs/expectedResponse"},
        "stateChecks": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/stateCheck"}},
        "trace": {
          "type": "object",
          "additionalProperties": false,
          "dependentRequired": {"eventCounts": ["settleSeconds"]},
          "required": ["node", "endpoint", "app", "timeoutSeconds", "requiredEvents"],
          "properties": {
            "node": {"$ref": "#/$defs/name"},
            "endpoint": {"$ref": "#/$defs/name"},
            "app": {"$ref": "#/$defs/name"},
            "timeoutSeconds": {"type": "integer", "minimum": 2, "maximum": 60},
            "settleSeconds": {"type": "integer", "minimum": 1, "maximum": 30},
            "eventCounts": {"type": "array", "minItems": 1, "maxItems": 16, "items": {
              "type": "object", "additionalProperties": false, "required": ["id", "match", "count"],
              "properties": {"id": {"$ref": "#/$defs/name"}, "match": {"$ref": "#/$defs/traceSelector"},
                             "count": {"$ref": "#/$defs/eventCount"}}
            }},
            "requiredEvents": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
                               "items": {"$ref": "#/$defs/traceSelector"}}
          }
        }
      }
    },
    "traceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "scenario", "scenarioDigest", "profile", "variants", "targetNode",
                   "coverage", "target", "events", "missingEvents"],
      "properties": {
        "schemaVersion": {"const": 2},
        "scenario": {"$ref": "#/$defs/name"},
        "scenarioDigest": {"$ref": "#/$defs/observation/properties/scenarioDigest"},
        "profile": {"$ref": "#/$defs/name"},
        "variants": {"$ref": "#/$defs/observation/properties/variants"},
        "targetNode": {"$ref": "#/$defs/name"},
        "coverage": {"enum": ["observed", "incomplete"]},
        "events": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/traceEvent"}},
        "missingEvents": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/traceSelector"}},
        "target": {"anyOf": [{"$ref": "#/$defs/observation/properties/target"}, {"type": "null"}]},
        "checks": {"type": "array", "minItems": 1, "maxItems": 33, "items": {"$ref": "#/$defs/checkEvidence"}},
        "reason": {"enum": ["query-unavailable", "invalid-events", "missing-events", "unstable-events",
                            "request-id-mismatch", "invalid-target-fields", "initial-check-not-met", "state-check-unavailable"]}
      },
      "allOf": [{
        "if": {"properties": {"coverage": {"const": "observed"}}},
        "then": {"properties": {"events": {"minItems": 1}, "missingEvents": {"maxItems": 0}},
                 "not": {"required": ["reason"]}},
        "else": {"required": ["reason"]}
      }, {
        "if": {"required": ["reason"], "properties": {"reason": {"const": "initial-check-not-met"}}},
        "then": {"required": ["checks"], "properties": {"target": {"type": "null"}, "events": {"maxItems": 0}}},
        "else": {"properties": {"target": {"type": "object"}}}
      }]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "name", "targetEndpoint", "dependency", "dependencyEndpoint", "request"],
      "properties": {
        "schemaVersion": {"const": 1},
        "name": {"$ref": "#/$defs/name"},
        "targetEndpoint": {"$ref": "#/$defs/name"},
        "dependency": {"$ref": "#/$defs/name"},
        "dependencyEndpoint": {"$ref": "#/$defs/name"},
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "path"],
          "properties": {
            "method": {"$ref": "#/$defs/method"},
            "path": {"$ref": "#/$defs/path"},
            "json": true
          }
        },
        "requestFields": {"$ref": "#/$defs/pointers"},
        "requestQuery": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/queryKey"}
        },
        "responseFields": {"$ref": "#/$defs/pointers"},
        "targetFields": {"$ref": "#/$defs/pointers"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "scenario", "scenarioDigest", "profile", "variants", "edge", "coverage", "target", "calls"],
      "properties": {
        "schemaVersion": {"const": 1},
        "scenario": {"$ref": "#/$defs/name"},
        "scenarioDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "profile": {"$ref": "#/$defs/name"},
        "variants": {
          "type": "object",
          "minProperties": 2,
          "propertyNames": {"$ref": "#/$defs/name"},
          "additionalProperties": {"$ref": "#/$defs/name"}
        },
        "edge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["caller", "dependency", "endpoint"],
          "properties": {
            "caller": {"$ref": "#/$defs/name"},
            "dependency": {"$ref": "#/$defs/name"},
            "endpoint": {"$ref": "#/$defs/name"}
          }
        },
        "coverage": {"enum": ["observed", "unobserved", "incomplete"]},
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "fields"],
          "properties": {"status": {"$ref": "#/$defs/status"}, "fields": {"$ref": "#/$defs/fields"}}
        },
        "calls": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "path", "status", "requestFields", "responseFields"],
            "properties": {
              "method": {"$ref": "#/$defs/method"},
              "path": {"$ref": "#/$defs/route"},
              "status": {"$ref": "#/$defs/status"},
              "requestFields": {"$ref": "#/$defs/fields"},
              "requestQuery": {
                "type": "object",
                "maxProperties": 16,
                "propertyNames": {"$ref": "#/$defs/queryKey"},
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {"type": "string", "maxLength": 2048}
                }
              },
              "responseFields": {"$ref": "#/$defs/fields"}
            }
          }
        }
      },
      "allOf": [{
        "if": {"properties": {"coverage": {"const": "observed"}}},
        "then": {"properties": {"calls": {"minItems": 1}}}
      }, {
        "if": {"properties": {"coverage": {"const": "unobserved"}}},
        "then": {"properties": {"calls": {"maxItems": 0}}}
      }]
    }
  }
}
